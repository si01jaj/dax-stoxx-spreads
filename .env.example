# --- LLM (opcional: sin clave la app funciona igual, solo sin texto del analista)
DEEPSEEK_API_KEY=sk-tu-key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=90

# --- Datos de mercado
# none (por defecto) = la IV se teclea desde el bróker y no se consulta nada por red.
# yahoo = intenta los índices de volatilidad (hoy dan 404; se deja por si vuelven).
IV_PROVIDER=none
# yahoo = precarga el contado; manual = no sale a internet en absoluto.
SPOT_PROVIDER=yahoo

# Factor de vol realizada asumida para POP/EV (0.90 = 10% por debajo de la implícita)
# Solo se usa cuando la petición no trae una vol realizada explícita.
REALIZED_VOL_FACTOR=0.90
VOL_SKEW=0.0217
RISK_FREE_RATE=0.025

# 0 = si no hay IV, FALLA (recomendado en modo manual). 1 = usa DEFAULT_IV marcándolo como asumido.
ALLOW_IV_FALLBACK=0
DEFAULT_IV=0.20

# --- Acceso
# Si se define, todas las rutas /api/* exigen la cabecera X-App-Token
# APP_TOKEN=cambia-esto
# CORS_ORIGINS=https://dax-stoxx.jj-apps.com

# Caché de datos de mercado en segundos
MARKET_CACHE_TTL=60
